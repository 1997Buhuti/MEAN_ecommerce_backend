# ==============================================================================
# Environment Configuration for MEAN Ecommerce Backend
# ==============================================================================

# Server Port (PM2 passes 3000 by default)
PORT=3000

# Node Environment
NODE_ENV=production

# Base API URI Route prefix (default: /api/v)
API_URI=/api/v

# MongoDB Connection String (MongoDB Atlas URI recommended)
# e.g.: mongodb+srv://<db_user>:<db_password>@<cluster-url>/ecommerce?retryWrites=true&w=majority
CONNECTION_STRING=mongodb+srv://username:password@cluster0.mongodb.net/ecommerce?retryWrites=true&w=majority

# JWT Authentication Secret Key (Minimum 16 characters)
SECRET=your-super-secret-jwt-key-min-16-characters-long
